# ============================================
# Camera Rental 环境变量模板
# ============================================
# 使用方法：
#   1. 复制本文件为 .env
#   2. 填入实际值
#   3. 使用 docker-compose 或在 IDE 中加载
# ============================================

# ========== 数据库 ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_root_password
DATASOURCE_URL=jdbc:mysql://localhost:3306/camera_rental?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=your_database_password

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ========== JWT ==========
# 生产环境请使用强随机字符串（至少 32 字节）
# 生成方式: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_at_least_32_chars

# ========== MinIO 文件存储 ==========
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# ========== Nacos ==========
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_NAMESPACE=

# ========== Sentinel ==========
SENTINEL_DASHBOARD=localhost:8858

# ========== Druid 监控 ==========
DRUID_PASSWORD=your_druid_password

# ========== Seata（分布式事务，默认关闭） ==========
SEATA_ENABLED=false

