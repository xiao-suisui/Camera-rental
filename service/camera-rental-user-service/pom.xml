<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>camera-rental-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>camera-rental-user-service</artifactId>
    <packaging>jar</packaging>
    <name>Camera Rental User Service</name>

    <dependencies>
        <!-- 公共依赖（web/nacos/sentinel/redis/mybatis/knife4j 等）均由 common 传递 -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>camera-rental-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- WebSocket（common 中 optional，此处显式引入） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 用户服务特有：密码加密（Spring Security Crypto） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

