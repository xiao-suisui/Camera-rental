# ============================================
# Camera Rental — Docker Compose 环境变量
# 使用方式：cp .env.example .env → 填入真实值
# ============================================

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_PORT=3306

# ===== Redis =====
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# ===== MinIO =====
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# ===== Nacos =====
NACOS_NAMESPACE=public

# ===== 前端 =====
FRONTEND_PORT=80

# ===== 服务副本数（水平扩容） =====
USER_SERVICE_REPLICAS=1
DEVICE_SERVICE_REPLICAS=1
ORDER_SERVICE_REPLICAS=1
COUPON_SERVICE_REPLICAS=1

