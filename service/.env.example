# ============================================
# Camera Rental — Docker Compose 环境变量
# 使用方式：cp .env.example .env → 填入真实值
# ============================================

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_PORT=3306

# ===== Redis =====
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# ===== 应用共享配置（Nacos secret-config.yaml 解析） =====
# 数据库（应用侧）
CAMERA_RENTAL_DB_PASSWORD=your_database_password

# JWT（至少 32 字节强随机）
CAMERA_RENTAL_JWT_SECRET=replace_with_a_strong_jwt_secret

# RabbitMQ（应用侧消费/生产者）
CAMERA_RENTAL_RABBITMQ_USER=app_user
CAMERA_RENTAL_RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password

# MinIO（应用侧上传/访问）
CAMERA_RENTAL_MINIO_ACCESS_KEY=replace_with_minio_access_key
CAMERA_RENTAL_MINIO_SECRET_KEY=replace_with_minio_secret_key

# Redis（应用侧）
CAMERA_RENTAL_REDIS_PASSWORD=your_redis_password

# Druid 监控（默认关闭，仅开窗排障时使用）
CAMERA_RENTAL_DRUID_USERNAME=ops_druid
CAMERA_RENTAL_DRUID_PASSWORD=replace_with_strong_druid_password
CAMERA_RENTAL_DRUID_ALLOW_IP=127.0.0.1

# ===== MinIO =====
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# ===== Nacos =====
NACOS_NAMESPACE=public

# Nacos 认证（生产必填，随机值用 openssl rand 生成）
NACOS_AUTH_TOKEN=replace_with_base64_token_at_least_32_bytes
NACOS_ADMIN_PASSWORD=replace_with_strong_nacos_password
NACOS_AUTH_IDENTITY_KEY=replace_with_random_hex_32
NACOS_AUTH_IDENTITY_VALUE=replace_with_random_hex_32

# ===== RabbitMQ 基础设施（容器初始化） =====
# 建议与 CAMERA_RENTAL_RABBITMQ_USER / PASSWORD 保持一致
RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password
RABBITMQ_VHOST=/camera-rental

# ===== 前端 =====
FRONTEND_PORT=80

# ===== 服务副本数（水平扩容） =====
USER_SERVICE_REPLICAS=1
DEVICE_SERVICE_REPLICAS=1
ORDER_SERVICE_REPLICAS=1
COUPON_SERVICE_REPLICAS=1

